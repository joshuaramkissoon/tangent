# Copy to .env. Only one model key is required; each extra key turns on more features.

# Margin answers, Spine and briefs. Together (DeepSeek V4.1 Flash) is used when set, otherwise Gemini.
TOGETHER_API_KEY=
# Composing readings from a question (Gemini with Google Search grounding). Also works for answers.
GEMINI_API_KEY=
# Optional: Claude writes evergreen deep dives while sources are found in parallel.
ANTHROPIC_API_KEY=
# Optional: OpenAI Decisions API decides whether a question needs a search first.
OPENAI_API_KEY=

# Optional overrides
# TANGENT_PROVIDER=together            # or gemini
# TANGENT_QUICK_MODEL=
# TANGENT_DEEP_MODEL=
# TANGENT_PRIMER_MODEL=gemini-3.5-flash-lite
# TANGENT_DEEP_DIVE_MODEL=gemini-3.8-flash
# TANGENT_WRITER_MODEL=claude-sonnet-5-5
# TANGENT_TRANSCRIBE_MODEL=openai/whisper-large-v3
# TANGENT_RATE_LIMIT=off               # per-IP hourly limits are on by default
